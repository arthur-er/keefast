{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeeFast",
  "mainBinaryName": "keefast",
  "identifier": "io.github.arthur-er.keefast",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "ui"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "KeeFast",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: kficon: http://kficon.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: kficon: http://kficon.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": true,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Fast password manager for KeePass Vault files"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERTQ3RUQ1ODlFQTFCMTUKUldRVkcrcUoxWDdralVvQWtoYlVLR2RzNlFJOVVNeC94aytqb0FjNUJvRXVRblZHWXRjMitZYWMK",
      "endpoints": [
        "https://github.com/arthur-er/keefast/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
