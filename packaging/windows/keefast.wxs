<?xml version="1.0" encoding="utf-8"?>
<!--
  keefast's Windows installer, built with WiX v5 by scripts/package-windows.ps1.

  It installs for the current user, without elevation, as browser integration is per user too:
  the app registers its native host under HKEY_CURRENT_USER, pointing at the keefast-native-host
  installed next to it. Uninstalling asks the app to remove those registrations, and Start on
  boot, first. keefast-agent, the command Agents run (`keefast-agent run`, ADR 0012), is
  installed beside them, and the install folder is added to the user's PATH so Agents can call
  it by name.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="KeeFast"
    Manufacturer="KeeFast"
    Version="$(var.Version)"
    UpgradeCode="96059a5e-f163-43fc-8426-01a7a3a94b36"
    Scope="perUser"
    Language="1033">

    <!-- A pre-release has its release's version, so the release must upgrade it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of keefast is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      keefast draws its window with the Microsoft Edge WebView2 Runtime (it is a Tauri app), which
      Windows 11 and up-to-date Windows 10 have. It registers its version (`pv`) per machine, or
      per user when a user installed it.
    -->
    <Property Id="WEBVIEW2_MACHINE">
      <RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="WEBVIEW2_USER">
      <RegistrySearch Root="HKCU" Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <Launch
      Condition="Installed OR (WEBVIEW2_MACHINE AND WEBVIEW2_MACHINE &lt;&gt; &quot;0.0.0.0&quot;) OR (WEBVIEW2_USER AND WEBVIEW2_USER &lt;&gt; &quot;0.0.0.0&quot;)"
      Message="keefast needs the Microsoft Edge WebView2 Runtime. Install it from https://go.microsoft.com/fwlink/p/?LinkId=2124703, then run this installer again." />

    <!-- The app's icon (crates/app/icons, made from assets/icon.svg) in Installed apps and on the shortcut. -->
    <Icon Id="keefast.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="keefast.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/arthur-er/keefast" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- %LOCALAPPDATA%\Programs\keefast, where per-user apps go. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="keefast" />
      </Directory>
    </StandardDirectory>

    <!--
      Files in the user's profile can't be key paths, so a registry value under
      HKEY_CURRENT_USER says each component is installed.
    -->
    <Component Id="Binaries" Directory="INSTALLFOLDER" Guid="4e559af4-1125-4e04-9b42-3ad6f447aec1">
      <File Id="keefast.exe" Source="$(var.BinDir)\keefast.exe" />
      <!-- The app looks for the native host next to itself when it registers it. -->
      <File Id="keefast_native_host.exe" Source="$(var.BinDir)\keefast-native-host.exe" />
      <!-- Agents run it as `keefast-agent run` from their shells. -->
      <File Id="keefast_agent.exe" Source="$(var.BinDir)\keefast-agent.exe" />
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\keefast\Installer" Name="Binaries" Type="integer" Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="keefast" Name="KeeFast" Icon="keefast.ico" Description="KeePass password manager" Target="[#keefast.exe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\keefast\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      Uninstalling removes what the app registered for the user: the browsers' registrations of
      keefast's native host, and only keefast's (the app knows which are its own, as KeePassXC
      registers under the same host name), and Start on boot.
      It is skipped when an upgrade removes the old version, so integration stays on, and
      uninstalling goes on even if it fails.
    -->
    <CustomAction
      Id="Unregister"
      FileRef="keefast.exe"
      ExeCommand="--unregister"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <!--
      The in-app updater (ADR 0014) exits keefast and runs this installer with AUTOLAUNCHAPP set,
      as for an installer Tauri makes: keefast starts again once the update is installed, with the
      arguments it ran with (LAUNCHAPPARGS).
    -->
    <CustomAction
      Id="LaunchAfterUpdate"
      FileRef="keefast.exe"
      ExeCommand="[LAUNCHAPPARGS]"
      Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="Unregister" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchAfterUpdate" After="InstallFinalize" Condition="AUTOLAUNCHAPP AND NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
