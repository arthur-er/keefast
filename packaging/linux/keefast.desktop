[Desktop Entry]
Type=Application
Name=keefast
GenericName=Password Manager
Comment=Fast, native password manager for KeePass Vault files
Exec=keefast %f
Icon=keefast
Terminal=false
Categories=Utility;Security;
Keywords=password;keepass;kdbx;vault;
MimeType=application/x-keepass2;
StartupWMClass=keefast
